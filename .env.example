# ===== LLM（OpenAI 兼容：DeepSeek / 智谱 GLM / OpenAI 均可）=====
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=填你的key
LLM_MODEL=deepseek-chat
# 无 key 时把 LLM_PROVIDER 改成 mock 也能跑通全链路

# ===== MySQL（本机 8.0.26，D:\Development\software\MySql\MySql 8.0）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=填root密码_仅初始化用
MYSQL_USER=agent_app
MYSQL_PASSWORD=请改成一个随机密码
MYSQL_DATABASE=agentinsight

# ===== Redis（Docker，可选，挂了系统自动降级）=====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== Agent Runtime =====
MAX_AGENT_STEPS=8
MAX_RETRY=2
SQL_MAX_ROWS=1000

# ===== 引擎路由：行数 >= 阈值走 Spark，否则 DuckDB =====
SPARK_ROW_THRESHOLD=100000
SPARK_IMAGE=apache/spark:3.5.1

# ===== 目录 =====
DATA_DIR=D:/Development/aiproject/AgentInsight/data
UPLOAD_DIR=D:/Development/aiproject/AgentInsight/data/uploads

# ===== 前端 =====
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
